<configuration>
    <!-- Local / Desarrollo: con colores y conciso para la consola -->
    <springProfile name="!production">
        <appender name="console-appender" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%highlight(%-5level) %cyan(%logger{32}) %mdc : %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Producción: sin colores ANSI, con timestamp ISO-8601, thread y nivel alineado -->
    <springProfile name="production">
        <appender name="console-appender" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} %mdc : %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="info">
        <appender-ref ref="console-appender"/>
    </root>
</configuration>
